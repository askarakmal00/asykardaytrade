[Unit]
Description=Asykar Day Trade Signal Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/AsykarDayTrade
ExecStart=/opt/AsykarDayTrade/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
EnvironmentFile=/opt/AsykarDayTrade/.env

[Install]
WantedBy=multi-user.target
